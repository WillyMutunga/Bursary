# Disable Apache MultiViews Content Negotiation to prevent 415 Unsupported Media Type errors
Options -MultiViews

# Disable Apache ModSecurity / Bot Protection scanning for API & Login requests
<IfModule mod_security2.c>
  SecRuleEngine Off
  SecFilterEngine Off
  SecFilterScanPOST Off
</IfModule>

<IfModule mod_security.c>
  SecFilterEngine Off
  SecFilterScanPOST Off
</IfModule>

# Disable Imunify360 WebShield Interception for API and Login routes
<IfModule mod_env.c>
  SetEnv MODSEC_BYPASS 1
  SetEnv IMUNIFY360_BYPASS 1
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg)$">
    Header set Content-Type "image/png"
  </FilesMatch>
  <FilesMatch "\.(json|webmanifest)$">
    Header set Content-Type "application/json; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Content-Type "application/javascript; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Content-Type "text/css; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Exclude backend API, Django admin, and portal_login from React SPA rewriting
  RewriteCond %{REQUEST_URI} ^/api [NC,OR]
  RewriteCond %{REQUEST_URI} ^/portal_login [NC,OR]
  RewriteCond %{REQUEST_URI} ^/login_gateway [NC,OR]
  RewriteCond %{REQUEST_URI} ^/backend [NC,OR]
  RewriteCond %{REQUEST_URI} ^/admin [NC]
  RewriteRule ^ - [L]

  # Rewrite all non-file/non-directory requests to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
