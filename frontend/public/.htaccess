# LiteSpeed & Apache Configuration for Bursary System
Options -MultiViews -Indexes

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle Authorization Header for Sanctum
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Route all /api/* requests to Laravel backend
  RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]
  RewriteRule ^api$ backend/public/index.php [L,QSA]

  # 1b. Route /storage/* to backend storage
  RewriteRule ^storage/(.*)$ backend/storage/app/public/$1 [L]

  # 2. Allow 1-Click setup runner
  RewriteRule ^deploy_setup\.php$ - [L]

  # 3. Serve physical files/directories directly (assets, images, scripts)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route all other client URLs to React SPA index.html
  RewriteRule . /index.html [L]
</IfModule>
